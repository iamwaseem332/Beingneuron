*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
.env
.env.local
.env.*
.pytest_cache/
.mypy_cache/
.coverage
coverage/
htmlcov/

# Compiled files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out
*.class

# OS generated files
.DS_Store
Thumbs.db

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
